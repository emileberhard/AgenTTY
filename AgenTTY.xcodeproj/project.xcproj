        "ENABLE_PREVIEWS": "YES",
        "EXCLUDED_SOURCE_FILE_NAMES": [
          "$(inherited)",
          ".gitkeep",
          ".DS_Store",
        ],
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/Vendor",
        ],
        "INFOPLIST_FILE": "Config/InfoPlists/AgenTTY-iOS-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "AgenTTY",
        "INFOPLIST_KEY_CFBundleShortVersionString": "$(MARKETING_VERSION)",
        "INFOPLIST_KEY_CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "0.0.0",
        "OTHER_LDFLAGS": [
          "$(inherited) -lc++",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(AGENTTY_BUNDLE_ID)",
        "PRODUCT_NAME": "AgenTTY_iOS",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": [
          "$(inherited)",
          "DEBUG",
        ],
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_REQUIRE_EXPLICIT_SENDABLE": "YES",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_STRICT_LANGUAGE_FEATURES": "YES",
        "SWIFT_STRICT_MEMORY_SAFETY": "YES",
        "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
        "SWIFT_UPCOMING_FEATURE_DISABLE_OUTWARD_ACTOR_INFERENCE": "YES",
        "SWIFT_UPCOMING_FEATURE_GLOBAL_ACTOR_ISOLATED_TYPES_USABILITY": "YES",
        "SWIFT_UPCOMING_FEATURE_INFER_ISOLATED_CONFORMANCES": "YES",
        "SWIFT_UPCOMING_FEATURE_INFER_SENDABLE_FROM_CAPTURES": "YES",
        "SWIFT_UPCOMING_FEATURE_NONISOLATED_NONSENDING_BY_DEFAULT": "YES",
        "SWIFT_VERSION": "6.0",
        "SWIFT_WARN_CONCURRENCY": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
