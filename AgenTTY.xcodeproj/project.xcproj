        "CODE_SIGN_STYLE[config=Debug]": "Automatic",
        "CODE_SIGN_STYLE[config=Release]": "Automatic",
        "ENABLE_PREVIEWS": "YES",
        "EXCLUDED_SOURCE_FILE_NAMES": [
          "$(inherited)",
          ".gitkeep",
          ".DS_Store",
        ],
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/Vendor",
        ],
        "INFOPLIST_FILE": "Config/InfoPlists/AgenTTY-iOS-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "AgenTTY",
        "INFOPLIST_KEY_CFBundleShortVersionString": "$(MARKETING_VERSION)",
        "INFOPLIST_KEY_CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "OTHER_LDFLAGS": [
          "$(inherited) -lc++",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(AGENTTY_BUNDLE_ID)",
        "PRODUCT_NAME": "AgenTTY_iOS",
