[Unit]
Description=AgenTTY rootless Docker engine
After=default.target

[Service]
Type=notify
NotifyAccess=all
Delegate=yes
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=builtin
ExecStartPre=/usr/bin/test -f /run/agentty-rootless-guard.ready
ExecStart=/usr/bin/dockerd-rootless.sh --host=unix:///run/agentty-docker/docker.sock --group=0 --data-root=%h/docker
Restart=always
RestartSec=5
OOMScoreAdjust=200
KillMode=mixed
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
