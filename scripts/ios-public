#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
operation="${1:?Use build, test, or archive}"
./scripts/ghostty-xcframework ensure
common=(-project AgenTTY.xcodeproj -disableAutomaticPackageResolution -onlyUsePackageVersionsFromResolvedFile -skipPackageUpdates -skipMacroValidation -jobs 4)
case "$operation" in
  build)
    xcodebuild build "${common[@]}" -scheme AgenTTY-iOS-Dev -configuration Debug \
      -destination 'generic/platform=iOS Simulator' ARCHS=arm64 CODE_SIGNING_ALLOWED=NO
    ;;
  test)
    simulator_id="$(AGENTTY_RELEASE_IOS_SIMULATOR_RUNTIME=latest ./scripts/resolve-release-simulator)"
    xcodebuild test "${common[@]}" -scheme AgenTTY-iOS-Tests -configuration Debug \
      -destination "platform=iOS Simulator,id=$simulator_id" CODE_SIGNING_ALLOWED=NO
    ;;
  archive)
    : "${ARCHIVE_PATH:?Set ARCHIVE_PATH to the new archive location}"
    versions=()
    if [[ -n "${MARKETING_VERSION:-}" ]]; then versions+=(MARKETING_VERSION="$MARKETING_VERSION"); fi
    if [[ -n "${CURRENT_PROJECT_VERSION:-}" ]]; then versions+=(CURRENT_PROJECT_VERSION="$CURRENT_PROJECT_VERSION"); fi
    xcodebuild archive "${common[@]}" -scheme AgenTTY-iOS -configuration Release \
      -destination 'generic/platform=iOS' -archivePath "$ARCHIVE_PATH" \
      ${versions[@]+"${versions[@]}"} CODE_SIGNING_ALLOWED=NO COMPILER_INDEX_STORE_ENABLE=NO
    ;;
  *) echo "Unknown operation: $operation" >&2; exit 2 ;;
esac
