#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

[[ -f AgenTTY/Resources/AgenTTYLocalSecrets.json ]] || {
  echo "AgenTTY/Resources/AgenTTYLocalSecrets.json is required for screenshot host authentication." >&2
  exit 1
}

./scripts/fetch-apple-bezels
device_inventory="$(./scripts/ensure-app-store-screenshot-simulators)"

screenshot_devices="${AGENTTY_SCREENSHOT_DEVICES:-ipad}"
# Per-scene budget for the app to reach its ready marker. Cold simulator
# boots and a loaded host can push a single scene past 60s.
ready_timeout_seconds="${AGENTTY_SCREENSHOT_READY_TIMEOUT_SECONDS:-60}"
iphone_id="$(printf '%s\n' "$device_inventory" | awk -F '\t' '$1 == "iPhone 17 Pro Max" { print $2 }')"
ipad_id="$(printf '%s\n' "$device_inventory" | awk -F '\t' '$1 == "iPad Pro 13-inch (M5)" { print $2 }')"
build_simulator_id="$ipad_id"

build_json="$(xcodebuildmcp simulator build \
  --project-path "$repo_root/AgenTTY.xcodeproj" \
  --scheme AgenTTY-iOS-Dev \
  --simulator-id "$build_simulator_id" \
  --configuration Debug \
  --extra-args ARCHS=arm64 \
  --extra-args ONLY_ACTIVE_ARCH=YES \
  --output json)"
printf '%s\n' "$build_json" | jq -e '.didError == false' >/dev/null

app_json="$(xcodebuildmcp simulator get-app-path \
  --project-path "$repo_root/AgenTTY.xcodeproj" \
  --scheme AgenTTY-iOS-Dev \
  --simulator-id "$build_simulator_id" \
  --configuration Debug \
  --platform 'iOS Simulator' \
  --output json)"
app_path="$(printf '%s\n' "$app_json" | jq -er '.data.artifacts.appPath')"

capture_device() {
  local kind="$1"
  local simulator_id="$2"
  local capture_prefix="$3"
  local output_directory="ascelerate/screenshots/en-US"
  local bundle_id="dev.tuist.agentty.iOS.dev"
  local data_container
  local ready_marker
  local captures=(
    "01-terminal-anywhere"
    "02-themes"
    "03-hosts"
    "04-switch-hosts"
    "05-secure-keys"
  )

  [[ -n "$simulator_id" ]] || { echo "Missing $kind screenshot simulator." >&2; exit 1; }
  simulator_state="$(xcrun simctl list devices -j | jq -r --arg id "$simulator_id" \
    '.devices[][] | select(.udid == $id) | .state')"
  if [[ "$simulator_state" != "Booted" ]]; then
    xcodebuildmcp simulator boot --simulator-id "$simulator_id" --output json >/dev/null
  fi
  xcodebuildmcp simulator install --simulator-id "$simulator_id" --app-path "$app_path" --output json >/dev/null
  data_container="$(xcrun simctl get_app_container "$simulator_id" "$bundle_id" data)"
  ready_marker="$data_container/tmp/agentty-screenshot-ready"
  mkdir -p "$output_directory"
  rm -f "$output_directory/$capture_prefix-"*.png

  for capture in "${captures[@]}"; do
    xcrun simctl terminate "$simulator_id" "$bundle_id" >/dev/null 2>&1 || true
    rm -f "$ready_marker"
    xcrun simctl launch --terminate-running-process "$simulator_id" "$bundle_id" \
      -ASC_SCREENSHOT YES \
      -ASC_SCREENSHOT_SCREEN "$capture" \
      -ASC_DISABLE_ANIMATIONS YES >/dev/null

    ready=false
    for _ in $(seq 1 $((ready_timeout_seconds * 4))); do
      if [[ -f "$ready_marker" && "$(cat "$ready_marker")" == "$capture" ]]; then
        ready=true
        break
      fi
      sleep 0.25
    done
    if [[ "$ready" != true ]]; then
      echo "Timed out waiting for $kind screenshot state: $capture" >&2
      exit 1
    fi
    sleep 1
    xcrun simctl io "$simulator_id" screenshot \
      "$output_directory/$capture_prefix-$capture.png" >/dev/null
  done
}

if [[ ",$screenshot_devices," == *,iphone,* ]]; then
  capture_device iphone "$iphone_id" "AgenTTY iPhone 17 Pro Max Screenshots iOS 26.5"
fi
if [[ ",$screenshot_devices," == *,ipad,* ]]; then
  capture_device ipad "$ipad_id" "AgenTTY iPad Pro 13-inch Screenshots iOS 26.5"
fi

ascelerate screenshot frame

rm -rf AppStoreScreenshots/public/framed
mkdir -p AppStoreScreenshots/public
cp -R ascelerate/screenshots/framed AppStoreScreenshots/public/framed

cd AppStoreScreenshots
bun install --frozen-lockfile
AGENTTY_SCREENSHOT_DEVICES="$screenshot_devices" bun run export

rm -rf ../ascelerate/media
mkdir -p ../ascelerate/media
unzip -q -o output/agentty-app-store-screenshots.zip -d ../ascelerate/media
AGENTTY_SCREENSHOT_DEVICES="$screenshot_devices" \
  ../scripts/validate-app-store-screenshots ../ascelerate/media

cd "$repo_root"
publish_set() {
  local source_directory="$1" placement_group="$2"
  rm -rf "AppStore/screenshots/$placement_group"
  mkdir -p "AppStore/screenshots/$placement_group"
  cp "$source_directory"/*.png "AppStore/screenshots/$placement_group/"
}
if [[ ",$screenshot_devices," == *,iphone,* ]]; then
  publish_set ascelerate/media/en-US/APP_IPHONE_69 IPHONE_DYNAMIC_ISLAND_LARGE_PROFILE
fi
if [[ ",$screenshot_devices," == *,ipad,* ]]; then
  publish_set ascelerate/media/en-US/APP_IPAD_PRO_3GEN_129 IPAD_13_PROFILE
fi
