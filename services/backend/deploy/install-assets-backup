#!/usr/bin/env bash
set -euo pipefail
[[ $# == 1 && "$1" == /* && -d "$1" ]] || { echo 'Usage: install-assets-backup ABSOLUTE_STAGING_DIRECTORY' >&2; exit 1; }
source_dir=$(cd "$(dirname "$0")" && pwd)
install -m 0700 "$source_dir/assets-select" "$1/agentty-assets.select"
install -m 0600 "$source_dir/assets-backup.policy" "$1/agentty-assets.policy"
