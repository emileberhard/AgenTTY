require "shellwords"
require "open3"
require "xcodeproj"

default_platform(:ios)

platform :ios do
  local_config_path = File.expand_path("../Config/Local.xcconfig", __dir__)
  LOCAL_BUILD_CONFIG = File.file?(local_config_path) ? Xcodeproj::Config.new(local_config_path).to_hash : {}
  APP_IDENTIFIER = ENV["AGENTTY_APP_IDENTIFIER"] || LOCAL_BUILD_CONFIG["AGENTTY_BUNDLE_ID"] || "com.example.AgenTTY"
  APP_NAME = ENV["AGENTTY_APP_NAME"].to_s.empty? ? "AgenTTY" : ENV["AGENTTY_APP_NAME"]
  APP_SKU = ENV["AGENTTY_APP_SKU"].to_s.empty? ? "agentty-001" : ENV["AGENTTY_APP_SKU"]
  WORKSPACE = "AgenTTY.xcworkspace"
  SCHEME = "AgenTTY-iOS"
  TEAM_ID = ENV["DEVELOPMENT_TEAM"] || LOCAL_BUILD_CONFIG["DEVELOPMENT_TEAM"]

  # App Store profiles cover the App Group main app plus its embedded
  # Notification Service extension. API-key cloud signing cannot manage App
  # Groups, so both profiles are pre-created via the ASC API and installed
  # before archive; Release signing pins them via PROVISIONING_PROFILE_SPECIFIER.
  IOS_APP_STORE_PROFILES = {
    APP_IDENTIFIER => "AgenTTY iOS App Store",
    "#{APP_IDENTIFIER}.NotificationService" => "AgenTTY Notification Service App Store"
  }.freeze
  # Development profiles pin the local `AgenTTY-iOS-Dev` device install path.
  IOS_DEVELOPMENT_PROFILES = {
    "#{APP_IDENTIFIER}.dev" => "AgenTTY iOS Dev Development",
    "#{APP_IDENTIFIER}.dev.NotificationService" => "AgenTTY Notification Service Dev Development"
  }.freeze

  def env_or_shared_env(key)
    value = ENV[key]
    return value if value && !value.empty?

    shared_env_candidates = [
      ENV["AGENTTY_SHARED_ENV_PATH"],
      "~/.config/agentty/env.sh",
      "~/configs/shared-env.sh"
    ].compact.map { |path| File.expand_path(path) }

    shared_env = shared_env_candidates.find { |path| File.exist?(path) }
    return nil unless shared_env

    command = "bash -lc 'source #{Shellwords.escape(shared_env)} >/dev/null 2>&1; printf %s \"${#{key}:-}\"'"
    output, status = Open3.capture2(command)
    return nil unless status.success?

    output = output.to_s.strip
    return nil if output.empty?

    ENV[key] = output
    output
  end

  def required_config(description, *keys)
    keys.each do |key|
      value = env_or_shared_env(key)
      return value if value && !value.empty?
    end

    UI.user_error!("Set #{keys.join(' or ')} for #{description}")
  end

  # ----------------------------------------------------------------
  # App Store Connect API-key auth (no Apple ID / 2FA).
  # APP_STORE_CONNECT_KEY_PATH is written by the release workflow step.
  # ----------------------------------------------------------------
  def app_store_connect_key_id
    env_or_shared_env("APP_STORE_CONNECT_KEY_ID") ||
      UI.user_error!("Set APP_STORE_CONNECT_KEY_ID")
  end

  def app_store_connect_issuer_id
    env_or_shared_env("APP_STORE_CONNECT_ISSUER_ID") ||
      UI.user_error!("Set APP_STORE_CONNECT_ISSUER_ID")
  end

  def app_store_connect_key_path
    env_or_shared_env("APP_STORE_CONNECT_KEY_PATH") ||
      UI.user_error!("Set APP_STORE_CONNECT_KEY_PATH")
  end

  def api_key
    app_store_connect_api_key(
      key_id: app_store_connect_key_id,
      issuer_id: app_store_connect_issuer_id,
      key_filepath: File.expand_path(app_store_connect_key_path)
    )
  end

  # ----------------------------------------------------------------
  # Canonical headless signing.
  # Every signing identity (development, distribution) lives in the shared
  # never-locked "apple-signing" keychain, provisioned by the apple-devops
  # skill and identical on dev Macs and the self-hosted runner. Exact named
  # profiles are created through the ASC API and installed read-only before
  # archive; there is no per-repo keychain, certificate secret, or login-
  # keychain unlock.
  # ----------------------------------------------------------------
  def apple_devops_script(name)
    path = File.expand_path("~/configs/skills/apple-devops/scripts/#{name}")
    UI.user_error!("Missing apple-devops helper: #{path}") unless File.exist?(path)
    Shellwords.escape(path)
  end

  def ensure_signing_keychain
    sh(apple_devops_script("ensure-signing-keychain"), log: false)
  end

  def install_profile(name, profile_type, bundle_id)
    sh(
      "uv run #{apple_devops_script('asc_api.py')} install-profile " \
      "--name #{Shellwords.escape(name)} --type #{profile_type} " \
      "--bundle-id #{Shellwords.escape(bundle_id)}",
      log: false
    )
  end

  def recreate_profile(name, profile_type, bundle_id)
    sh(
      "uv run #{apple_devops_script('asc_api.py')} recreate-profile " \
      "--name #{Shellwords.escape(name)} --type #{profile_type} " \
      "--bundle-id #{Shellwords.escape(bundle_id)}",
      log: false
    )
  end

  def next_global_build_number
    Integer(
      sh(
        "uv run #{apple_devops_script('asc_api.py')} next-build-number " \
        "--bundle-id #{Shellwords.escape(APP_IDENTIFIER)}",
        log: false
      ).strip,
      10
    )
  end

  def clear_sigh_lane_context
    # sigh accumulates profile paths in lane context. Clear them between
    # maintenance operations so one target cannot contaminate the next.
    [
      SharedValues::SIGH_PROFILE_PATH,
      SharedValues::SIGH_PROFILE_PATHS,
      SharedValues::SIGH_UDID,
      SharedValues::SIGH_UUID,
      SharedValues::SIGH_NAME,
      SharedValues::SIGH_PROFILE_TYPE
    ].each { |key| Actions.lane_context[key] = nil }

    %w[SIGH_UDID SIGH_UUID SIGH_NAME].each { |key| ENV.delete(key) }
  end

  def install_ios_development_profiles(key)
    ensure_signing_keychain

    IOS_DEVELOPMENT_PROFILES.each do |identifier, profile_name|
      sigh(
        api_key: key,
        app_identifier: identifier,
        platform: "ios",
        provisioning_name: profile_name,
        development: true,
        force: true,
        include_all_certificates: true
      )
      install_profile(profile_name, "IOS_APP_DEVELOPMENT", identifier)
      clear_sigh_lane_context
    end
  end

  def install_release_package_lock!
    script = File.expand_path("../scripts/install-release-package-lock", __dir__)
    sh("#{Shellwords.escape(script)} --install", log: false)
  end

  def verify_release_package_lock!
    script = File.expand_path("../scripts/install-release-package-lock", __dir__)
    sh("#{Shellwords.escape(script)} --check-installed", log: false)
  end

  def sentry_auth_token
    env_or_shared_env("SENTRY_AUTH_TOKEN") ||
      UI.user_error!("Set SENTRY_AUTH_TOKEN for Sentry dSYM uploads")
  end

  def sentry_organization_slug
    required_config("Sentry organization slug", "SENTRY_ORG", "AGENTTY_SENTRY_ORG")
  end

  def sentry_project_slug
    env_or_shared_env("SENTRY_PROJECT") || env_or_shared_env("AGENTTY_SENTRY_PROJECT") || "agentty"
  end

  def release_version(options)
    explicit = options[:version].to_s.strip
    return explicit unless explicit.empty?

    env_version = ENV["MARKETING_VERSION"].to_s.strip
    return env_version unless env_version.empty?

    raw = sh(
      "xcodebuild -workspace #{WORKSPACE.shellescape} -scheme #{SCHEME.shellescape} -configuration Release -showBuildSettings 2>/dev/null",
      log: false
    )
    build_setting_version = raw.lines
      .find { |line| line.include?("MARKETING_VERSION") }
      .to_s
      .split("=")
      .last
      .to_s
      .strip

    if build_setting_version.empty? || build_setting_version == "0.0.0"
      resolved = sh("./scripts/resolve-release-marketing-version", log: false).to_s.strip
      return resolved unless resolved.empty?
      UI.user_error!("failed to resolve release marketing version from MARKETING_VERSION or an exact semver tag at HEAD")
    end

    build_setting_version
  end

  def project_target_source(target_name:, next_target_name:)
    project_path = File.expand_path("../Project.swift", __dir__)
    project_source = File.read(project_path)

    target_start = project_source.index("name: \"#{target_name}\"")
    UI.user_error!("could not find #{target_name} in #{project_path}") unless target_start

    next_target_start = project_source.index("name: \"#{next_target_name}\"", target_start)
    UI.user_error!("could not find #{next_target_name} after #{target_name} in #{project_path}") unless next_target_start

    project_source[target_start...next_target_start]
  end

  def ensure_local_main_unlock_disabled_for_release!
    main_target_source = project_target_source(
      target_name: "AgenTTY-iOS",
      next_target_name: "AgenTTY-iOS-Dev"
    )

    return unless main_target_source.include?("AGENTTY_LOCAL_MAIN_UNLOCK")

    UI.user_error!("AGENTTY_LOCAL_MAIN_UNLOCK must never be enabled for TestFlight/App Store builds")
  end

  def ensure_sentry_cli_installed!
    return if system("command -v sentry-cli >/dev/null 2>&1")

    UI.user_error!("sentry-cli is required for Sentry dSYM uploads")
  end

  def sentry_dsym_upload_path
    candidates = []

    dsym_output_path = Actions.lane_context[SharedValues::DSYM_OUTPUT_PATH]
    candidates << dsym_output_path if dsym_output_path

    archive_path = Actions.lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    if archive_path
      archive_dsym_dir = File.join(archive_path, "dSYMs")
      candidates << archive_dsym_dir if Dir.exist?(archive_dsym_dir)
    end

    ipa_output_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    if ipa_output_path
      candidates.concat(Dir[File.join(File.dirname(ipa_output_path), "*.dSYM.zip")])
    end

    resolved = candidates
      .compact
      .map { |path| File.expand_path(path) }
      .find do |path|
        File.exist?(path) && (File.directory?(path) || path.end_with?(".dSYM", ".dSYM.zip"))
      end

    return resolved if resolved

    UI.user_error!("Could not find dSYM output from the current build")
  end

  def upload_dsyms_to_sentry!
    ensure_sentry_cli_installed!

    dsym_path = sentry_dsym_upload_path
    UI.message("Uploading dSYMs to Sentry from #{dsym_path}.")

    sh(
      {
        "SENTRY_AUTH_TOKEN" => sentry_auth_token,
        "SENTRY_ORG" => sentry_organization_slug,
        "SENTRY_PROJECT" => sentry_project_slug
      },
      "sentry-cli debug-files upload --include-sources #{Shellwords.escape(dsym_path)}"
    )
  end

  desc "Create AgenTTY app in App Store Connect and Developer Portal"
  lane :create_app do
    create_app_online(
      username: env_or_shared_env("APPLE_ID_EMAIL"),
      app_identifier: APP_IDENTIFIER,
      app_name: APP_NAME,
      sku: APP_SKU,
      language: "en-US",
      team_id: TEAM_ID,
      itc_team_id: env_or_shared_env("APPLE_ID_ITC_TEAM_ID")
    )
  end

  desc "Upload App Store metadata, and screenshots unless skip_screenshots:true"
  lane :metadata do |options|
    version = release_version(options)
    sh("./scripts/check-release-version", version, "--metadata")
    # Screenshots are generated and visually reviewed locally (`just
    # screenshots`) and the tracked set lags the live listing's device classes.
    skip_screenshots = options[:skip_screenshots].to_s != "false"
    if !skip_screenshots && Dir[File.expand_path("screenshots/**/*.png", __dir__)].empty?
      UI.user_error!("Generate and review screenshots locally before enabling screenshot upload")
    end
    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_screenshots: skip_screenshots,
      skip_binary_upload: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Repair and install iOS App Store + development provisioning profiles"
  lane :install_ios_profiles do
    key = api_key
    ensure_signing_keychain

    # App Store distribution profiles: repair (recreate) then install.
    IOS_APP_STORE_PROFILES.each do |bundle_id, profile_name|
      recreate_profile(profile_name, "IOS_APP_STORE", bundle_id)
      install_profile(profile_name, "IOS_APP_STORE", bundle_id)
    end

    # Development profiles for local device installs: force-recreate via sigh so
    # they re-embed the current team development certificates in one command,
    # then install. Re-run this lane after any certificate revocation.
    install_ios_development_profiles(key)
  end

  desc "Validate release credentials and production build policy"
  lane :release_preflight do
    ensure_local_main_unlock_disabled_for_release!
    api_key
    ensure_signing_keychain
    IOS_APP_STORE_PROFILES.each { |bundle_id, name| install_profile(name, "IOS_APP_STORE", bundle_id) }
    sentry_auth_token
    sentry_organization_slug
    sentry_project_slug
    ensure_sentry_cli_installed!
    UI.success("Release credentials, signing keychain, App Store profiles, and production build policy are valid.")
  end

  desc "Build and upload AgenTTY to TestFlight"
  lane :beta do |options|
    key = api_key
    version = release_version(options)
    ensure_local_main_unlock_disabled_for_release!

    build_number = next_global_build_number
    UI.message("Using version #{version} build #{build_number}.")

    install_release_package_lock!
    ensure_signing_keychain
    IOS_APP_STORE_PROFILES.each { |bundle_id, name| install_profile(name, "IOS_APP_STORE", bundle_id) }

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      include_symbols: true,
      skip_profile_detection: true,
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: IOS_APP_STORE_PROFILES.dup
      },
      disable_package_automatic_updates: true,
      skip_package_repository_fetches: true,
      xcargs: "-onlyUsePackageVersionsFromResolvedFile MARKETING_VERSION='#{version}' CURRENT_PROJECT_VERSION='#{build_number}'"
    )
    verify_release_package_lock!

    upload_dsyms_to_sentry!

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      uses_non_exempt_encryption: false,
      skip_waiting_for_build_processing: true
    )
  end
end
