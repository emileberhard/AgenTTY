#!/usr/bin/env python3
import os
import sqlite3
import tempfile
from pathlib import Path

state = Path("/srv/services/agentty-backend")
source = state / "notify-relay.sqlite3"
if not source.is_file():
    raise SystemExit(f"Missing database: {source}")
destination = state / "backup" / "notify-relay.sqlite3"
destination.parent.mkdir(mode=0o700, exist_ok=True)
fd, temporary_name = tempfile.mkstemp(prefix=".agentty-", suffix=".db", dir=destination.parent)
os.close(fd)
temporary = Path(temporary_name)
try:
    with sqlite3.connect(f"file:{source}?mode=ro", uri=True) as live, sqlite3.connect(temporary) as backup:
        live.backup(backup)
        result = backup.execute("PRAGMA quick_check").fetchone()
        if result != ("ok",):
            raise RuntimeError(f"SQLite backup integrity check failed: {result}")
    with temporary.open("rb") as output:
        os.fsync(output.fileno())
    os.replace(temporary, destination)
    directory_fd = os.open(destination.parent, os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    temporary.unlink(missing_ok=True)
