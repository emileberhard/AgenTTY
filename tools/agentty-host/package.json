{
  "name": "@agentty-app/pair",
  "version": "0.0.0",
  "description": "Pairing CLI for connecting a computer to AgenTTY.",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "bin": {
    "agentty-pair": "bin/agentty-host.js"
  },
  "scripts": {
    "build": "bun run typecheck && bun ./scripts/build.mjs",
    "prepack": "bun run build",
    "test": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emileberhard/AgenTTY.git",
    "directory": "tools/agentty-host"
  }
}
