#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
lock_file="$repo_root/Package.resolved"
install=false
check_installed=false

case "${1:---validate}" in
  --validate)
    ;;
  --install)
    install=true
    ;;
  --check-installed)
    check_installed=true
    ;;
  -h|--help)
    printf 'Usage: install-release-package-lock [--validate|--install|--check-installed]\n'
    exit 0
    ;;
  *)
    echo "Unknown argument: $1" >&2
    exit 2
    ;;
esac

python3 - "$lock_file" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    payload = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as error:
    raise SystemExit(f"FATAL: invalid release package lock {path}: {error}")

pins = payload.get("pins")
if payload.get("version") != 3 or not isinstance(pins, list) or not pins:
    raise SystemExit(f"FATAL: unsupported or empty release package lock: {path}")

identities = []
for pin in pins:
    identity = pin.get("identity")
    state = pin.get("state", {})
    revision = state.get("revision")
    if not isinstance(identity, str) or not identity:
        raise SystemExit("FATAL: release package lock contains a pin without an identity")
    if not isinstance(revision, str) or re.fullmatch(r"[0-9a-f]{40}", revision) is None:
        raise SystemExit(f"FATAL: package {identity} is not pinned to a full Git revision")
    if "branch" in state:
        raise SystemExit(f"FATAL: package {identity} retains mutable branch metadata")
    identities.append(identity)

if len(identities) != len(set(identities)):
    raise SystemExit("FATAL: release package lock contains duplicate identities")
if identities != sorted(identities):
    raise SystemExit("FATAL: release package lock pins must be sorted by identity")

print(f"Release package lock verified: {len(pins)} exact revisions")
PY

if [[ "$install" == false && "$check_installed" == false ]]; then
  exit 0
fi

targets=(
  "$repo_root/AgenTTY.xcworkspace/xcshareddata/swiftpm/Package.resolved"
  "$repo_root/AgenTTY.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
)
for target in "${targets[@]}"; do
  if [[ "$install" == true ]]; then
    mkdir -p "$(dirname "$target")"
    cp "$lock_file" "$target"
  fi
  cmp -s "$lock_file" "$target" || {
    echo "FATAL: generated package lock drifted from $lock_file: $target" >&2
    exit 1
  }
done

if [[ "$install" == true ]]; then
  echo "Installed release package lock into generated Xcode workspace and project"
else
  echo "Generated Xcode package locks match the canonical release lock"
fi
