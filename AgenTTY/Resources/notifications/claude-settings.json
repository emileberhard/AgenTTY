{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agentty/bin/agentty-notify\" record-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agentty/bin/agentty-notify\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
